# ----------------------------------------
# Python + pandas project .gitignore
# ----------------------------------------

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
.conda/
*.conda
*.env

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
# Usually these files are written by a Python script from a template
# before PyInstaller builds the exe, so as to inject date/other info.
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
*.log
pytest_cache/

# mypy, pyright, pyre, etc.
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# Jupyter Notebook checkpoints & metadata
.ipynb_checkpoints/
*.ipynb-meta.json

# IDE / Editor settings
.vscode/
.idea/
*.swp
*.swo
*.bak
*.tmp

# Data files (you can adjust these as needed)
data/*.csv
data/*.xlsx
data/*.parquet
data/*.json
!data/README.md  # Keep a readme if you have one

# Logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp
*.temp

# OS-specific files
.DS_Store
Thumbs.db

# Environment variables and secrets
.env
.env.*
*.pem
*.key

# Jupyter Notebook outputs (optional — useful if outputs are large)
# Uncomment the following to ignore all notebook output cells
# *.ipynb

# Project-specific cache
.cache/
__pypackages__/

